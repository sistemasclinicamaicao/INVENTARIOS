# ═══════════════════════════════════════════════════════════
# WORKER — servicio: inventarios-worker (OBLIGATORIO para sync automática)
# Mismo Dockerfile: backend/Dockerfile
# Comando de arranque: npm run start:worker
# Sin este servicio, Redis no tendrá cron INVIMA y la sync diaria NO correrá.
# ═══════════════════════════════════════════════════════════

NODE_ENV=production
DATABASE_URL=postgres://postgres:PASSWORD@host:5434/clinica_erp?sslmode=disable
REDIS_URL=redis://chat_redis:6379
INTEGRATION_SECRET_KEY=<mismo valor que backend>
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=noresponder@clinicamaicao.com
SMTP_PASS=<app password>
SMTP_FROM=noresponder@clinicamaicao.com
SMTP_FROM_NAME=Clínica Maicao — Inventarios
SMTP_REPLY_TO=noresponder@clinicamaicao.com
INVIMA_VENCIDOS_ALERT_TO=correo1@...,correo2@...
ERP_USE_MOCK=false
TZ=America/Bogota

# Job INVIMA: sync diario + alertas por email (cron configurable)
# INVIMA_SYNC_CRON=0 6 * * *        → 6:00 AM diario
# INVIMA_SYNC_CRON=30 7 * * *       → 7:30 AM diario
# INVIMA_SYNC_CRON=53 17 * * *      → 5:53 PM diario
# INVIMA_SYNC_CRON_TZ=America/Bogota
# INVIMA_SYNC_CRON_ENABLED=true
# Job sincroniza 7 catálogos: 4 INVIMA CUM + POS + PMV (nauz-qkjw) + Krystalos REST
INVIMA_SYNC_CRON=53 17 * * *
INVIMA_SYNC_CRON_TZ=America/Bogota
INVIMA_SYNC_CRON_ENABLED=true

# Verificación tras deploy del worker (logs al arrancar):
#   Worker started — HR sync cada 6 h; INVIMA sync diario — cron "53 17 * * *" (America/Bogota)
# API (autenticada): GET /api/v1/integrations/external/sync-diagnostics
#   → bull.repeatableJobs debe incluir name "daily" con nextBogota coherente

# ═══════════════════════════════════════════════════════════
# FRONTEND — servicio: inventario-fronted
# Dockerfile: frontend/Dockerfile
# Dominio: https://chat-inventario-fronted.rhfh8t.easypanel.host
# Proxy interno API: http://chat_inventarios-backend:80
# ═══════════════════════════════════════════════════════════

NODE_ENV=production
HOST=0.0.0.0
PORT=3000
NUXT_API_PROXY=http://chat_inventarios-backend:80
NUXT_PUBLIC_AUTH_DISABLED=false
NUXT_TELEMETRY_DISABLED=1
